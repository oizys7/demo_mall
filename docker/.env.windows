# Windows Docker Desktop 开发环境配置
# 环境标识
ENVIRONMENT=dev
PLATFORM=windows-docker-desktop

# 应用配置
APP_VERSION=1.0.0
DOCKER_REGISTRY_PREFIX=demo-mall

# Java 运行时配置
JAVA_OPTS=-Xmx512m -Xms256m -Djava.security.egd=file:/dev/./urandom

# 服务端口配置
GATEWAY_PORT=9100
USER_SERVICE_PORT=9201
PRODUCT_SERVICE_PORT=9202
ORDER_SERVICE_PORT=9203

# 基础设施服务配置
POSTGRES_HOST=host.docker.internal
POSTGRES_PORT=5432
POSTGRES_DB=demo_mall
POSTGRES_USER=oizys
POSTGRES_PASSWORD=postgres123

REDIS_HOST=host.docker.internal
REDIS_PORT=6379

ELASTICSEARCH_HOST=host.docker.internal
ELASTICSEARCH_PORT=9200

NACOS_HOST=host.docker.internal
NACOS_PORT=8848

# Windows Docker Desktop 特定配置
COMPOSE_CONVERT_WINDOWS_PATHS=1
COMPOSE_PATH_SEPARATOR=;

# 开发环境特定配置
SPRING_PROFILES_ACTIVE=dev
LOG_LEVEL=DEBUG

# 健康检查配置
HEALTH_CHECK_INTERVAL=30s
HEALTH_CHECK_TIMEOUT=10s
HEALTH_CHECK_RETRIES=3

# 开发环境卷挂载配置
VOLUME_SOURCE_BASE=./
VOLUME_TARGET_BASE=/app

# 网络配置
NETWORK_NAME=demo-mall-network
NETWORK_DRIVER=bridge