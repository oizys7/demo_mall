# Ubuntu 生产环境配置
# 环境标识
ENVIRONMENT=prod
PLATFORM=ubuntu-docker

# 应用配置
APP_VERSION=1.0.0
DOCKER_REGISTRY_PREFIX=demo-mall

# Java 运行时配置（生产环境优化）
JAVA_OPTS=-Xmx256m -Xms128m -XX:+UseG1GC -XX:+UseContainerSupport -XX:MaxRAMPercentage=75.0

# 服务端口配置
GATEWAY_PORT=9100
USER_SERVICE_PORT=9201
PRODUCT_SERVICE_PORT=9202
ORDER_SERVICE_PORT=9203

# 基础设施服务配置
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=demo_mall
POSTGRES_USER=oizys
POSTGRES_PASSWORD=postgres123

REDIS_HOST=redis
REDIS_PORT=6379

ELASTICSEARCH_HOST=elasticsearch
ELASTICSEARCH_PORT=9200

NACOS_HOST=nacos
NACOS_PORT=8848

# 生产环境特定配置
SPRING_PROFILES_ACTIVE=prod
LOG_LEVEL=INFO

# 健康检查配置
HEALTH_CHECK_INTERVAL=30s
HEALTH_CHECK_TIMEOUT=10s
HEALTH_CHECK_RETRIES=5

# 生产环境卷挂载配置
VOLUME_SOURCE_BASE=/var/lib/demo-mall
VOLUME_TARGET_BASE=/data

# 网络配置
NETWORK_NAME=demo-mall-network
NETWORK_DRIVER=bridge

# 生产环境安全配置
RUN_AS_USER=appuser
RUN_AS_GROUP=appuser

# 资源限制配置
DEFAULT_MEMORY_LIMIT=512M
DEFAULT_CPU_LIMIT=0.5
DEFAULT_RESTART_POLICY=unless-stopped

# 日志配置
LOG_DRIVER=json-file
LOG_MAX_SIZE=10m
LOG_MAX_FILE=3