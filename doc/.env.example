# Demo Mall 环境变量配置示例
# 复制此文件为 .env 并设置实际的密码值

# PostgreSQL 数据库密码
# 必须设置此环境变量才能连接到数据库
PGSQL_PASSWD=your_postgresql_password_here

# 可选的其他环境变量
# JWT 密钥（如果需要）
# JWT_SECRET=your_jwt_secret_here

# 应用端口配置（可选）
# USER_SERVICE_PORT=9201
# PRODUCT_SERVICE_PORT=9202
# ORDER_SERVICE_PORT=9203
# GATEWAY_PORT=9100

# 日志级别（可选）
# LOG_LEVEL=INFO

# Redis 配置（如果使用）
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_PASSWORD=your_redis_password_here